# ──────────────────────────────────────────────────────────────────────────────
# HaushaltsBuch — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ──────────────────────────────────────────────────────────────────────────────

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=haushaltsbuch
DB_USERNAME=haushaltsbuch
DB_PASSWORD=change_me_db_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origin for the backend (your frontend domain)
# Examples:
#   *                            (allow all — only for development!)
#   https://haushalt.example.com (your production frontend URL)
CORS_ORIGIN=*

# ── OCR Service ──────────────────────────────────────────────────────────────
# URL the backend uses to reach the OCR service.
# In Docker Compose: http://ocr-service:8001
# For local development (backend outside Docker): http://localhost:8001
OCR_SERVICE_URL=http://ocr-service:8001

# ── Frontend ──────────────────────────────────────────────────────────────────
API_URL=/api
